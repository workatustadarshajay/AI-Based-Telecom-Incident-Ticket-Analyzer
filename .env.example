# Root environment for docker compose — copy to .env and fill in.
#   cp .env.example .env
# Get a Gemini API key (starts with AIza) at https://aistudio.google.com/apikey

# --- LLM / embeddings (required) ---
GEMINI_API_KEY=AIza...your-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- PostgreSQL (compose sets these for the db service) ---
POSTGRES_USER=careloop
POSTGRES_PASSWORD=careloop
POSTGRES_DB=telecom_analyzer

# The backend builds its DATABASE_URL from these parts inside compose:
# postgresql://<user>:<password>@db:5432/<db>

# --- API ---
API_PORT=8001
WEB_PORT=5173
