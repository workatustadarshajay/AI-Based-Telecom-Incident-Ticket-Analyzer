# ---- LLM / Embeddings (Google Gemini) ----
# Get a key at https://aistudio.google.com/apikey (keys start with AIza)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Database ----
# Local dev: the Docker Postgres on localhost. In compose this is overridden to db:5432.
DATABASE_URL=postgresql://careloop:careloop@localhost:5432/telecom_analyzer

# ---- Workflow thresholds (report 5.8 router rules) ----
CONFIDENCE_THRESHOLD=0.6

# ---- Paths (relative to the app working directory) ----
DATA_DIR=data
CHROMA_DIR=data/chroma

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8001
